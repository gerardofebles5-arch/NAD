# ══════════════════════════════════════════════════════════════
#  PINAD SaaS - Variables de Entorno de Ejemplo
# ══════════════════════════════════════════════════════════════
# Copia este archivo a .env y configura los valores reales
# Nunca commits el archivo .env con credenciales reales

# ── Stripe (Pagos con tarjeta) ─────────────────────────────────────
# Obtén estas credenciales en https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_your_stripe_api_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Price IDs de Stripe (creados en el Dashboard de Stripe)
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=price_your_pro_plan_price_id
STRIPE_PRICE_ENTERPRISE=price_your_enterprise_plan_price_id

# ── Pagos Locales (Venezuela) ──────────────────────────────────────
# PagoMóvil
PAGOMOVIL_BANK=Banco de Venezuela
PAGOMOVIL_PHONE=04141234567
PAGOMOVIL_CI=12345678

# Zelle
ZELLE_EMAIL=pagos@pinad-saas.com
ZELLE_NAME=PINAD SaaS

# USDT (Binance Pay / Transferencia)
USDT_WALLET=0x1234567890abcdef1234567890abcdef12345678
USDT_NETWORK=TRC20
BINANCE_PAY_ID=your_binance_pay_id_here

# ── Facturación ─────────────────────────────────────────────────────
# Información de la empresa para facturas
INVOICE_COMPANY_NAME=PINAD SaaS C.A.
INVOICE_COMPANY_ADDRESS=Av. Principal, Edificio A, Piso 5, Caracas, Venezuela
INVOICE_COMPANY_RIF=J-12345678-9
INVOICE_COMPANY_EMAIL=facturacion@pinad-saas.com
INVOICE_COMPANY_PHONE=+58-212-1234567

# ── Servidor ────────────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
DISABLE_SSL=false

# ── Base de Datos ────────────────────────────────────────────────────
# La base de datos SQLite se guarda en el directorio de output
# No requiere configuración adicional

# ── Supabase (Base de datos en la nube) ───────────────────────────────
# Obtén estas credenciales en https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# ── Directorios ─────────────────────────────────────────────────────
TEMP_DIR=temp
OUTPUT_DIR=output

# ── Debug ───────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
